# Copy this file to .env and fill in real values

# Database configuration
PG_DATABASE=your_database
PG_USER=your_username
PG_PASSWORD=your_password
PG_HOST=localhost
PG_PORT=5432
PG_SCHEMA=wt_dev

# Xdebug configuration
XDEBUG_MODE=debug
XDEBUG_CONFIG=client_host=host.docker.internal client_port=9003


# Test/dev features (fixed code 111111 for test addresses, peek_code, seeders, schema switching,
# test cookies, no real email). Set ONLY on local test machines - never in production.
APP_ENV=test
# Extra origins allowed to POST to the login router (comma separated). The local dev origins
# http://localhost:8111 and http://127.0.0.1:8111 are allowed automatically only when APP_ENV=test;
# otherwise list them here.
# ALLOWED_ORIGINS=http://localhost:8111,http://127.0.0.1:8111

# Email: Scaleway Transactional Email (sender domain mail.weightloss-tracker.com, region fr-par).
SCW_SECRET_KEY=
SCW_PROJECT_ID=
MAIL_FROM_EMAIL=noreply@mail.weightloss-tracker.com
MAIL_FROM_NAME=Weightloss Tracker
# MAIL_DISABLED=true switches email off (local runs only).
